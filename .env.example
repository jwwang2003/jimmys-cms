# AWS / S3
# Provide credentials via env vars, `aws configure`, SSO, or another AWS SDK mechanism.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SDK_LOAD_CONFIG=1
AWS_REGION=us-east-2
S3_BUCKET=your-bucket-name

# Optional CloudFront distribution for the default bucket alias
# CLOUDFRONT_DISTRIBUTION_ID=

# Prefixes (no leading slash)
CONTENT_PREFIX=content
MEDIA_PREFIX=media
PUBLIC_PREFIX=public
META_PREFIX=meta

# Database
SQLITE_URL=sqlite.db

# CMS admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session signing
SESSION_SECRET=replace-with-a-long-random-secret

# Editor ("user" role) self-registration is disabled in production because
# editors can upload, delete, and publish. Set to 1 only if you really want
# anyone who finds /login to be able to create an editor account. Guest
# registration stays open either way (guests are read-only).
# ALLOW_PUBLIC_REGISTRATION=0

# Droplet-only: enables the litestream service in deploy/docker-compose.yml
# once the backups bucket + token below are configured.
# COMPOSE_PROFILES=backup

# Auth base URL (canonical CMS hostname). Leave blank for same-origin.
# Server-side (Better Auth) reads AUTH_BASE_URL; the browser client reads the
# NEXT_PUBLIC_ copy, which is inlined into the client bundle at build time.
# AUTH_BASE_URL=https://cms.jwwang.ca
# NEXT_PUBLIC_AUTH_BASE_URL=https://cms.jwwang.ca
# Comma-separated hostnames allowed to reach the app (Better Auth CSRF origin check)
# AUTH_TRUSTED_ORIGINS=https://cms.jwwang.ca,https://cms.glorialan.com

# Google Maps API
# Leave blank to disable server-side geocoding.
# GOOGLE_MAPS_API_KEY=
# Optional proxy for Google Maps requests, e.g. http://127.0.0.1:7890
# GOOGLE_MAPS_PROXY_URL=

# Optional startup S3 verification controls
# CHECK_S3_ON_STARTUP=1
# FAIL_ON_STARTUP_S3=1

# --- Cloudflare R2 -------------------------------------------------------
# R2 speaks the S3 API, so it is reached by pointing the same client at a
# different endpoint. The account-scoped host is derived from the account id.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Bucket aliases. R2_BUCKET_<ALIAS> inherits the account endpoint and the
# credentials above; masters is private, media is public via a custom domain.
#
# Each alias can carry its own token instead, which is the recommended split:
# a token scoped to the public media bucket then cannot reach the masters,
# which hold the only copy of the original pixels.
#   R2_ACCESS_KEY_ID_MEDIA=
#   R2_SECRET_ACCESS_KEY_MEDIA=
# A per-alias R2_ENDPOINT_<ALIAS> also allows a bucket on a different account.
#
# Litestream replicates the SQLite catalog to a third, private bucket. Backups
# must not sit behind the media bucket's public custom domain.
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# R2_BUCKET_BACKUPS=jimmys-cms-backups
# R2_ACCESS_KEY_ID_BACKUPS=
# R2_SECRET_ACCESS_KEY_BACKUPS=
# R2_BUCKET_MASTERS=jimmys-cms-masters
# R2_BUCKET_MEDIA=jimmys-cms-media
# R2_CDN_BASE_URL_MEDIA=https://media.jwwang.ca

# Any S3-compatible endpoint can also be declared the long way:
# S3_BUCKET_<ALIAS>, S3_REGION_<ALIAS>, S3_ENDPOINT_<ALIAS>,
# S3_ACCESS_KEY_ID_<ALIAS>, S3_SECRET_ACCESS_KEY_<ALIAS>,
# S3_FORCE_PATH_STYLE_<ALIAS>, S3_CDN_BASE_URL_<ALIAS>
